{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "implementer",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "deny",
    "doom_loop": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push origin main*": "deny",
      "git push origin HEAD:main*": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",
      "git rebase -i*": "deny",
      "git branch -D*": "deny",
      "gh pr merge*": "deny",
      "gh issue close*": "deny",
      "gh issue delete*": "deny",
      "gh repo *": "deny",
      "gh secret *": "deny",
      "gh auth *": "deny",
      "gh label *": "deny",
      "gh workflow *": "deny",
      "gh api -X DELETE*": "deny",
      "gh api --method DELETE*": "deny",
      "python scripts/agent/tick.py*": "deny",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "curl * | sh*": "deny",
      "curl * | bash*": "deny",
      "docker system prune*": "deny",
      "docker run --privileged*": "deny"
    }
  }
}
